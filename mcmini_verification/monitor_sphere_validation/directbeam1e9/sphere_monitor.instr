DEFINE INSTRUMENT sphere_validate(
  )

TRACE

COMPONENT Origin = Progress_bar()
AT (0,0,0) ABSOLUTE

// Explicit, reproducible beam definition
COMPONENT src = Source_simple(
    radius = 0.25,
    dist = 1.0,
    focus_xw = 0.5,
    focus_yh = 0.5,
    lambda0 = 4.0,
    dlambda = 0.1
) AT (0,0,0) RELATIVE Origin
ROTATED (0, 0, 0) ABSOLUTE

COMPONENT mon_4pi = PSD_monitor_4PI(
  nx = 3600,
  ny = 1800,
  radius = 1.0,
  restore_neutron = 1,
  filename = "source_to_4pi_monitor.dat"
)
AT (0,0,0) ABSOLUTE


END
