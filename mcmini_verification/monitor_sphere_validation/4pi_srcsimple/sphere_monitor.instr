DEFINE INSTRUMENT beam_validate()

TRACE
COMPONENT Origin = Progress_bar()
AT (0,0,0) ABSOLUTE

// Explicit, reproducible beam definition
COMPONENT src = Source_simple(
    radius = 0.2,
    dist = 1.0,
    focus_xw = 1.0,
    focus_yh = 1.0,
    lambda0 = 4.0,
    dlambda = 0.1
) AT (0,0,0) RELATIVE Origin
ROTATED (0, 0, 0) RELATIVE PREVIOUS


COMPONENT mon = PSD_monitor_4PI(
    nx = 360,
    ny = 180,
    filename = "sphere_hits",
    radius = 1.0
) AT (0, 0, 0) RELATIVE src



END