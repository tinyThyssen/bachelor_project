DEFINE INSTRUMENT beam_validate(lambda=5.0, dlambda=0.5)

TRACE
COMPONENT Origin = Progress_bar()
AT (0,0,0) ABSOLUTE

// Explicit, reproducible beam definition
COMPONENT src = Source_div(
  xwidth   = 0.4,      // full width of source rectangle (choose to mimic your disk)
  yheight  = 0.4,      // full height of source rectangle
  focus_aw = 10,       // deg (horizontal divergence width)
  focus_ah = 10,       // deg (vertical divergence width)
  lambda0  = lambda,
  dlambda  = dlambda,
  flux     = 1
)
AT (0,0,0) RELATIVE Origin


COMPONENT mon = PSD_monitor_4PI(
    nx = 360,
    ny = 180,
    filename = "sphere_hits",
    radius = 1.5
) AT (0,0, 0) RELATIVE src



END