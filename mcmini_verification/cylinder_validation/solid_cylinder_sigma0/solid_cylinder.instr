/*******************************************************************************
* McStas instrument for validating MCmini solid-cylinder setup.
*******************************************************************************/

DEFINE INSTRUMENT solid_cylinder_validation(
  lambda = 5.0,
  dlambda = 0.5,
  cylinder_radius = 0.015,
  cylinder_height = 0.1,
  source_radius = 0.05,
  source_dist = 1.0,
  focus_xw = 0.04,
  focus_yh = 0.08,
  packing_factor = 0.6,
  unit_cell_volume = 13.827,
  sigma_inc = 0.0,
  sigma_abs = 0.0,
  p_interact = 0.0,
  target_index = 0
)

TRACE

COMPONENT Origin = Progress_bar()
AT (0,0,0) ABSOLUTE

/* MCmini SourceSimple center is at z = -1.0 m */
COMPONENT src = Source_simple(
  radius = source_radius,
  dist = source_dist,
  focus_xw = focus_xw,
  focus_yh = focus_yh,
  lambda0 = lambda,
  dlambda = dlambda,
  flux = 1,
  gauss = 0
)
AT (0,0,-0.1) ABSOLUTE

COMPONENT init = Union_init()
AT (0,0,0) ABSOLUTE

/* Match MCmini scatterer defaults: sigma_inc=5.0, pack=0.6, Vc=10 A^3 */
COMPONENT sample_inc = Incoherent_process(
  sigma = sigma_inc,
  packing_factor = packing_factor,
  unit_cell_volume = unit_cell_volume
)
AT (0,0,0) ABSOLUTE

/* Match MCmini sigma_abs=0.4 barn -> macro abs = sigma*100*pack/Vc */
COMPONENT sample_mat = Union_make_material(
  process_string = "sample_inc",
  my_absorption =  sigma_abs * 1e2 / 13.827 //set to zero for zero absorption, otherwise set to ~25
)
AT (0,0,0) ABSOLUTE

COMPONENT solid_cylinder = Union_cylinder(
    priority = 10,
    radius = cylinder_radius,
    yheight = cylinder_height,
    material_string = "sample_mat",
    p_interact = p_interact,
    target_index = target_index
)
AT (0,0,0) RELATIVE PREVIOUS


COMPONENT master = Union_master()
AT (0,0,0) ABSOLUTE

COMPONENT stop = Union_stop()
AT (0,0,0) ABSOLUTE


// COMPONENT beamstop = Beamstop(
//  radius = 0.08
// ) 
// AT (0,0, 1.0) RELATIVE Origin


COMPONENT mon_4pi = PSD_monitor_4PI(
  nx = 360,
  ny = 180,
  radius = 1.0,
  restore_neutron = 1,
  filename = "solid_cylinder_multiple_scatter.dat"
)
AT (0,0,0) ABSOLUTE

END
