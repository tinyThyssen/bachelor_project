/*******************************************************************************
* McStas instrument for validating MCmini solid-cylinder setup.
*******************************************************************************/

DEFINE INSTRUMENT solid_cylinder_validation(
  lambda = 5.0,
  dlambda = 0.5,
  cylinder_radius = 0.005, //m
  cylinder_height = 0.02, //m
  margin = 0.005, // margin added
  unit_cell_volume = 13.827, // 
  sigma_inc = 5.08,
  sigma_abs = 5.08
)

DECLARE
%{
  int    n_reflections;
%}

TRACE

COMPONENT Origin = Progress_bar()
AT (0,0,0) ABSOLUTE

/* MCmini SourceSimple center is at z = -0.1 m */
COMPONENT src = Source_simple(
  radius = cylinder_height/2, // use height as that will always be the largest
  dist = 1.0,
  focus_xw = 2 * cylinder_radius + margin, // add small margin to ensure full illumination of cylinder
  focus_yh = cylinder_height + margin, // add small margin to ensure full illumination of cylinder
  lambda0 = lambda,
  dlambda = dlambda,
  flux = 1,
  gauss = 0
)
AT (0,0,-0.1) ABSOLUTE

COMPONENT init = Union_init()
AT (0,0,0) ABSOLUTE

COMPONENT sample_inc = Incoherent_process(
  sigma = sigma_inc,
  unit_cell_volume = unit_cell_volume
)
AT (0,0,0) ABSOLUTE

/* Match MCmini sigma_abs=0.4 barn -> macro abs = sigma*100*pack/Vc */
COMPONENT sample_mat = Union_make_material(
  process_string = "sample_inc",
  my_absorption =  sigma_abs * 1e2 / unit_cell_volume 
)
AT (0,0,0) ABSOLUTE

COMPONENT solid_cylinder = Union_cylinder(
    priority = 10,
    radius = cylinder_radius,
    yheight = cylinder_height,
    material_string = "sample_mat"
)
AT (0,0,0) RELATIVE PREVIOUS


COMPONENT master = Union_master()
AT (0,0,0) ABSOLUTE
EXTEND %{
n_reflections = SCATTERED - 2;
%}

COMPONENT stop = Union_stop()
AT (0,0,0) ABSOLUTE


COMPONENT beamstop = Beamstop(
  radius = 0.08
) 
AT (0,0, 1.0) RELATIVE Origin

COMPONENT mon_4pi = PSD_monitor_4PI(
  nx = 360,
  ny = 180,
  radius = 1.0,
  restore_neutron = 1,
  filename = "solid_cylinder_multiple_scatter.dat"
)
WHEN (n_reflections >= 0)
AT (0,0,0) ABSOLUTE

COMPONENT mon_4pi_s1 = PSD_monitor_4PI(
  nx = 360,
  ny = 180,
  radius = 1.0,
  restore_neutron = 1,
  filename = "solid_cylinder_scatter_1.dat"
)
WHEN (n_reflections == 1)
AT (0,0,0) ABSOLUTE

COMPONENT mon_4pi_s2 = PSD_monitor_4PI(
  nx = 360,
  ny = 180,
  radius = 1.0,
  restore_neutron = 1,
  filename = "solid_cylinder_scatter_2.dat"
)
WHEN (n_reflections == 2)
AT (0,0,0) ABSOLUTE

COMPONENT mon_4pi_s3 = PSD_monitor_4PI(
  nx = 360,
  ny = 180,
  radius = 1.0,
  restore_neutron = 1,
  filename = "solid_cylinder_scatter_3.dat"
)
WHEN (n_reflections == 3)
AT (0,0,0) ABSOLUTE

COMPONENT mon_4pi_s4 = PSD_monitor_4PI(
  nx = 360,
  ny = 180,
  radius = 1.0,
  restore_neutron = 1,
  filename = "solid_cylinder_scatter_4.dat"
)
WHEN (n_reflections == 4)
AT (0,0,0) ABSOLUTE

COMPONENT mon_4pi_s5 = PSD_monitor_4PI(
  nx = 360,
  ny = 180,
  radius = 1.0,
  restore_neutron = 1,
  filename = "solid_cylinder_scatter_5.dat"
)
WHEN (n_reflections == 5)
AT (0,0,0) ABSOLUTE


END
