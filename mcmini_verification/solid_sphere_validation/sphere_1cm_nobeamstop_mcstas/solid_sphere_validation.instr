/*******************************************************************************
* McStas instrument for validating MCmini solid-sphere setup.
*******************************************************************************/

DEFINE INSTRUMENT solid_sphere_validation(
  lambda = 4.0,
  dlambda = 0.1,
  sphere_radius = 0.01,
  source_radius = 0.01,
  source_dist = 1.0,
  focus_xw = 0.02,
  focus_yh = 0.02,
  sigma_inc = 5.08,
  sigma_abs = 5.08,
  unit_cell_volume = 13.827
)

DECLARE
%{
  int    n_reflections;
%}

TRACE

COMPONENT Origin = Progress_bar()
AT (0,0,0) ABSOLUTE


COMPONENT src = Source_simple(
  radius = source_radius,
  dist = source_dist,
  focus_xw = focus_xw,
  focus_yh = focus_yh,
  lambda0 = lambda,
  dlambda = dlambda,
  flux = 1,
  gauss = 0
)
AT (0,0,-0.1) ABSOLUTE

COMPONENT init = Union_init()
AT (0,0,0) ABSOLUTE


COMPONENT sample_inc = Incoherent_process(
  sigma = sigma_inc,
  unit_cell_volume = unit_cell_volume
)
AT (0,0,0) ABSOLUTE


COMPONENT sample_mat = Union_make_material(
  process_string = "sample_inc",
  my_absorption = sigma_abs * 1e2  / unit_cell_volume
)
AT (0,0,0) ABSOLUTE

COMPONENT solid_sphere = Union_sphere(
  material_string = "sample_mat",
  priority = 10,
  radius = sphere_radius
)
AT (0,0,0) ABSOLUTE

COMPONENT master = Union_master()
AT (0,0,0) ABSOLUTE
EXTEND %{
n_reflections = SCATTERED - 2;
%}

COMPONENT stop = Union_stop()
AT (0,0,0) ABSOLUTE


COMPONENT mon_4pi = PSD_monitor_4PI(
  nx = 360,
  ny = 180,
  radius = 1.0,
  restore_neutron = 1,
  filename = "solid_cylinder_multiple_scatter.dat"
)
WHEN (n_reflections > 0)
AT (0,0,0) ABSOLUTE

COMPONENT mon_4pi_s1 = PSD_monitor_4PI(
  nx = 360,
  ny = 180,
  radius = 1.0,
  restore_neutron = 1,
  filename = "solid_cylinder_scatter_1.dat"
)
WHEN (n_reflections == 1)
AT (0,0,0) ABSOLUTE

COMPONENT mon_4pi_s2 = PSD_monitor_4PI(
  nx = 360,
  ny = 180,
  radius = 1.0,
  restore_neutron = 1,
  filename = "solid_cylinder_scatter_2.dat"
)
WHEN (n_reflections == 2)
AT (0,0,0) ABSOLUTE

COMPONENT mon_4pi_s3 = PSD_monitor_4PI(
  nx = 360,
  ny = 180,
  radius = 1.0,
  restore_neutron = 1,
  filename = "solid_cylinder_scatter_3.dat"
)
WHEN (n_reflections == 3)
AT (0,0,0) ABSOLUTE

COMPONENT mon_4pi_s4 = PSD_monitor_4PI(
  nx = 360,
  ny = 180,
  radius = 1.0,
  restore_neutron = 1,
  filename = "solid_cylinder_scatter_4.dat"
)
WHEN (n_reflections == 4)
AT (0,0,0) ABSOLUTE

COMPONENT mon_4pi_s5 = PSD_monitor_4PI(
  nx = 360,
  ny = 180,
  radius = 1.0,
  restore_neutron = 1,
  filename = "solid_cylinder_scatter_5.dat"
)
WHEN (n_reflections == 5)
AT (0,0,0) ABSOLUTE


END
